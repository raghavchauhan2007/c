\PYG{+w}{    }\PYG{p}{\PYGZcb{}}

\PYG{+w}{    }\PYG{n}{bw}\PYG{o}{\PYGZhy{}\PYGZgt{}}\PYG{n}{buffer}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{bw}\PYG{o}{\PYGZhy{}\PYGZgt{}}\PYG{n}{bitCount}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{p}{;}
\PYG{+w}{    }\PYG{k}{return}\PYG{+w}{ }\PYG{n}{SUCCESS}\PYG{p}{;}
