\PYG{c+cm}{ * Enum for error handling}
\PYG{c+cm}{ * */}

\PYG{k}{typedef}\PYG{+w}{ }\PYG{k}{enum}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{    }\PYG{n}{SUCCESS}\PYG{p}{,}
\PYG{+w}{    }\PYG{n}{ERR\PYGZus{}MEMORY}\PYG{p}{,}
\PYG{+w}{    }\PYG{n}{ERR\PYGZus{}FILE}\PYG{p}{,}
