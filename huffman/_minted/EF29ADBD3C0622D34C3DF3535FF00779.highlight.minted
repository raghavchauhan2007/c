\PYG{+w}{    }\PYG{n}{ERR\PYGZus{}RECURSION\PYGZus{}DEPTH}\PYG{p}{,}
\PYG{+w}{    }\PYG{n}{ERR\PYGZus{}WRITE}\PYG{p}{,}
\PYG{+w}{    }\PYG{n}{ERR\PYGZus{}FORMAT}\PYG{p}{,}
