\PYG{c+cm}{/**}
\PYG{c+cm}{ * Writes the bits into buffer first and packs them into a byte}
\PYG{c+cm}{ * Once the buffer is full of 8 bits it is flushed to the file}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * Bits are written in MSB first order}
\PYG{c+cm}{ * */}

\PYG{n}{Status}\PYG{+w}{ }\PYG{n+nf}{writeBits}\PYG{p}{(}\PYG{n}{BitWriter}\PYG{+w}{ }\PYG{o}{*}\PYG{n}{bw}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{uint64\PYGZus{}t}\PYG{+w}{ }\PYG{n}{bits}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{uint8\PYGZus{}t}\PYG{+w}{ }\PYG{n}{length}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{    }\PYG{k}{for}\PYG{p}{(}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{i}\PYG{o}{=}\PYG{n}{length}\PYG{l+m+mi}{\PYGZhy{}1}\PYG{p}{;}\PYG{+w}{ }\PYG{n}{i}\PYG{o}{\PYGZgt{}=}\PYG{l+m+mi}{0}\PYG{p}{;}\PYG{+w}{ }\PYG{n}{i}\PYG{o}{\PYGZhy{}\PYGZhy{}}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{        }\PYG{k+kt}{uint8\PYGZus{}t}\PYG{+w}{ }\PYG{n}{bit}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{p}{(}\PYG{k+kt}{uint8\PYGZus{}t}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{((}\PYG{n}{bits}\PYG{+w}{ }\PYG{o}{\PYGZgt{}\PYGZgt{}}\PYG{+w}{ }\PYG{n}{i}\PYG{p}{)}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{p}{);}

\PYG{+w}{        }\PYG{n}{bw}\PYG{o}{\PYGZhy{}\PYGZgt{}}\PYG{n}{buffer}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{p}{(}\PYG{k+kt}{uint8\PYGZus{}t}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{((}\PYG{n}{bw}\PYG{o}{\PYGZhy{}\PYGZgt{}}\PYG{n}{buffer}\PYG{+w}{ }\PYG{o}{\PYGZlt{}\PYGZlt{}}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{p}{)}\PYG{+w}{ }\PYG{o}{|}\PYG{+w}{ }\PYG{n}{bit}\PYG{p}{);}
\PYG{+w}{        }\PYG{n}{bw}\PYG{o}{\PYGZhy{}\PYGZgt{}}\PYG{n}{bitCount}\PYG{o}{++}\PYG{p}{;}

\PYG{+w}{        }\PYG{k}{if}\PYG{p}{(}\PYG{n}{bw}\PYG{o}{\PYGZhy{}\PYGZgt{}}\PYG{n}{bitCount}\PYG{+w}{ }\PYG{o}{==}\PYG{+w}{ }\PYG{l+m+mi}{8}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{            }\PYG{k}{if}\PYG{p}{(}\PYG{n}{fwrite}\PYG{p}{(}\PYG{o}{\PYGZam{}}\PYG{n}{bw}\PYG{o}{\PYGZhy{}\PYGZgt{}}\PYG{n}{buffer}\PYG{p}{,}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{p}{,}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{bw}\PYG{o}{\PYGZhy{}\PYGZgt{}}\PYG{n}{f}\PYG{p}{)}\PYG{+w}{ }\PYG{o}{!=}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{p}{)}\PYG{+w}{ }\PYG{k}{return}\PYG{+w}{ }\PYG{n}{ERR\PYGZus{}WRITE}\PYG{p}{;}

\PYG{+w}{            }\PYG{n}{bw}\PYG{o}{\PYGZhy{}\PYGZgt{}}\PYG{n}{buffer}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{p}{;}
\PYG{+w}{            }\PYG{n}{bw}\PYG{o}{\PYGZhy{}\PYGZgt{}}\PYG{n}{bitCount}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{p}{;}
\PYG{+w}{        }\PYG{p}{\PYGZcb{}}
\PYG{+w}{    }\PYG{p}{\PYGZcb{}}

\PYG{+w}{    }\PYG{k}{return}\PYG{+w}{ }\PYG{n}{SUCCESS}\PYG{p}{;}
\PYG{p}{\PYGZcb{}}

\PYG{c+cm}{/**}
\PYG{c+cm}{ * At the end the file may have less than 8 bits}
\PYG{c+cm}{ *}
\PYG{c+cm}{ * To handle this we write the bits following MSB first ordering}
\PYG{c+cm}{ * and then pad the remaining bits to 0 and then flush to the file}
\PYG{c+cm}{ * */}

\PYG{n}{Status}\PYG{+w}{ }\PYG{n+nf}{writePaddedBits}\PYG{p}{(}\PYG{n}{BitWriter}\PYG{+w}{ }\PYG{o}{*}\PYG{n}{bw}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{    }\PYG{c+c1}{// pads leftover bits with 0s and writes them to file}
\PYG{+w}{    }\PYG{k}{if}\PYG{p}{(}\PYG{n}{bw}\PYG{o}{\PYGZhy{}\PYGZgt{}}\PYG{n}{bitCount}\PYG{+w}{ }\PYG{o}{==}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{p}{)}\PYG{+w}{ }\PYG{k}{return}\PYG{+w}{ }\PYG{n}{SUCCESS}\PYG{p}{;}
\PYG{+w}{    }\PYG{n}{bw}\PYG{o}{\PYGZhy{}\PYGZgt{}}\PYG{n}{buffer}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{p}{(}\PYG{k+kt}{uint8\PYGZus{}t}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{bw}\PYG{o}{\PYGZhy{}\PYGZgt{}}\PYG{n}{buffer}\PYG{+w}{ }\PYG{o}{\PYGZlt{}\PYGZlt{}}\PYG{+w}{ }\PYG{p}{(}\PYG{l+m+mi}{8}\PYG{o}{\PYGZhy{}}\PYG{n}{bw}\PYG{o}{\PYGZhy{}\PYGZgt{}}\PYG{n}{bitCount}\PYG{p}{));}

\PYG{+w}{    }\PYG{k}{if}\PYG{p}{(}\PYG{n}{fwrite}\PYG{p}{(}\PYG{o}{\PYGZam{}}\PYG{n}{bw}\PYG{o}{\PYGZhy{}\PYGZgt{}}\PYG{n}{buffer}\PYG{p}{,}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{p}{,}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{bw}\PYG{o}{\PYGZhy{}\PYGZgt{}}\PYG{n}{f}\PYG{p}{)}\PYG{+w}{ }\PYG{o}{!=}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{p}{)}\PYG{+w}{ }\PYG{k}{return}\PYG{+w}{ }\PYG{n}{ERR\PYGZus{}WRITE}\PYG{p}{;}

\PYG{+w}{    }\PYG{n}{bw}\PYG{o}{\PYGZhy{}\PYGZgt{}}\PYG{n}{buffer}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{bw}\PYG{o}{\PYGZhy{}\PYGZgt{}}\PYG{n}{bitCount}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{p}{;}
