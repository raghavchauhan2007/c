\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{c+cm}{/*}
\PYG{c+cm}{HUFF2412 File Format Specification (Encoder v1 / Decoder v1)}

\PYG{c+cm}{Overview}
\PYG{c+cm}{\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{c+cm}{This program writes and reads a Huffman\PYGZhy{}compressed file format. The output file is:}

\PYG{c+cm}{  [HEADER (byte\PYGZhy{}aligned fields + bit\PYGZhy{}packed tree)] [PAYLOAD (bit\PYGZhy{}packed codes)]}

\PYG{c+cm}{\PYGZdq{}Payload\PYGZdq{} = the compressed bitstream for the original file contents, produced by}
\PYG{c+cm}{replacing each input byte with its Huffman code bits.}

\PYG{c+cm}{IMPORTANT: Multi\PYGZhy{}byte integers are written using the platform\PYGZsq{}s native in\PYGZhy{}memory}
\PYG{c+cm}{representation (typically little\PYGZhy{}endian). This format is therefore NOT portable}
\PYG{c+cm}{across architectures with different endianness unless an explicit byte order is used.}

\PYG{c+cm}{Header Layout (in order)}
\PYG{c+cm}{\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{c+cm}{1) Magic (8 bytes)}
\PYG{c+cm}{   ASCII bytes: \PYGZsq{}H\PYGZsq{} \PYGZsq{}U\PYGZsq{} \PYGZsq{}F\PYGZsq{} \PYGZsq{}F\PYGZsq{} \PYGZsq{}2\PYGZsq{} \PYGZsq{}4\PYGZsq{} \PYGZsq{}1\PYGZsq{} \PYGZsq{}2\PYGZsq{}}
\PYG{c+cm}{   Used to identify files produced by this compressor.}

\PYG{c+cm}{2) Original Size (uint64\PYGZus{}t, 8 bytes)}
\PYG{c+cm}{   Exact number of bytes in the original uncompressed input file.}
\PYG{c+cm}{   Decoder MUST stop after producing exactly this many bytes (ignores any final padding).}

\PYG{c+cm}{3) Stored Filename Length (uint16\PYGZus{}t, 2 bytes)}
\PYG{c+cm}{   Length in bytes of the stored filename string.}

\PYG{c+cm}{4) Stored Filename (nameLen bytes)}
\PYG{c+cm}{   Raw bytes of the input file base name (includes extension), not NUL\PYGZhy{}terminated.}
\PYG{c+cm}{   Example: \PYGZdq{}photo.png\PYGZdq{} or \PYGZdq{}archive.tar.gz\PYGZdq{}.}

\PYG{c+cm}{   Decoder behavior:}
\PYG{c+cm}{   \PYGZhy{} The decoder attempts to write output to this filename in the current directory.}
\PYG{c+cm}{   \PYGZhy{} If the file already exists, the decoder prompts the user before overwriting.}

\PYG{c+cm}{5) Tree Bit Length (uint32\PYGZus{}t, 4 bytes)}
\PYG{c+cm}{   Number of bits used to encode the serialized Huffman tree that immediately follows.}
\PYG{c+cm}{   This allows the decoder to know exactly where the tree ends and where the payload begins.}

\PYG{c+cm}{6) Serialized Huffman Tree (treeBitsLen bits, bit\PYGZhy{}packed)}
\PYG{c+cm}{   Preorder serialization (MSB\PYGZhy{}first bit order within each byte):}
\PYG{c+cm}{     \PYGZhy{} Leaf node:}
\PYG{c+cm}{         write bit 1}
\PYG{c+cm}{         then write 8 bits of the leaf byte value}
\PYG{c+cm}{       Total = 9 bits per leaf.}

\PYG{c+cm}{     \PYGZhy{} Internal node:}
\PYG{c+cm}{         write bit 0}
\PYG{c+cm}{         then serialize left subtree}
\PYG{c+cm}{         then serialize right subtree}
\PYG{c+cm}{       Total = 1 bit + left subtree bits + right subtree bits.}

\PYG{c+cm}{7) Tree Padding (0..7 bits)}
\PYG{c+cm}{   After the tree bits are written, the encoder pads with 0 bits up to the next}
\PYG{c+cm}{   byte boundary so that the payload starts on a byte boundary.}
\PYG{c+cm}{   Decoder should discard these padding bits by aligning to the next byte boundary.}

\PYG{c+cm}{Payload Layout}
\PYG{c+cm}{\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{c+cm}{8) Huffman Payload Bits (variable length, bit\PYGZhy{}packed)}
\PYG{c+cm}{   For each input byte, the encoder writes the corresponding Huffman code bits}
\PYG{c+cm}{   (from the code table built from the Huffman tree).}
\PYG{c+cm}{   Bit order is MSB\PYGZhy{}first within output bytes, matching the BitWriter/BitReader.}

\PYG{c+cm}{9) Final Padding (0..7 bits)}
\PYG{c+cm}{   After encoding all symbols, the encoder pads the last output byte with 0 bits}
\PYG{c+cm}{   (if needed) and flushes it.}
\PYG{c+cm}{   The decoder ignores any remaining padding bits because it stops after outputting}
\PYG{c+cm}{   exactly Original Size bytes.}

\PYG{c+cm}{Notes / Constraints / Error Handling}
\PYG{c+cm}{\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{c+cm}{\PYGZhy{} Empty input files are currently rejected by the encoder.}
\PYG{c+cm}{\PYGZhy{} Codes are limited to 64 bits in this implementation (ERR\PYGZus{}RECURSION\PYGZus{}DEPTH if exceeded).}
\PYG{c+cm}{\PYGZhy{} Decoder detects invalid/corrupt streams as ERR\PYGZus{}FORMAT (bad magic, invalid tree encoding,}
\PYG{c+cm}{  impossible traversal, mismatched treeBitsLen consumption, etc.).}
\PYG{c+cm}{\PYGZhy{} I/O failures while reading return ERR\PYGZus{}READ; I/O failures while writing return ERR\PYGZus{}WRITE.}
\PYG{c+cm}{\PYGZhy{} If the user declines overwrite when output already exists, the decoder returns ERR\PYGZus{}ABORTED.}
\PYG{c+cm}{*/}

