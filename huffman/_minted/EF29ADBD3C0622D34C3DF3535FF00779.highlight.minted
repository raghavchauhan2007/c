\PYG{+w}{    }\PYG{n}{bw}\PYG{o}{\PYGZhy{}\PYGZgt{}}\PYG{n}{f}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n+nb}{NULL}\PYG{p}{;}
\PYG{+w}{    }\PYG{k}{return}\PYG{+w}{ }\PYG{n}{SUCCESS}\PYG{p}{;}
\PYG{p}{\PYGZcb{}}

